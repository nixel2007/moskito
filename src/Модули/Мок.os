#Использовать logos
#Использовать decorator

#Использовать "./internal"

Перем Лог;
Перем Сервис;

// Создаёт мок объекта или типа.
// Методы мока по умолчанию возвращают NULL и не вызывают исходный объект.
//
// Параметры:
//   ИсходныйОбъект - Произвольный - Инстанс мокируемого объекта
//                  - Тип - Тип мокируемого объекта. Если инстанс типа создать
//                          нельзя, мок строится без него
//
//  Возвращаемое значение:
//   Произвольный - Мок объекта
//
Функция Получить(Знач ИсходныйОбъект) Экспорт

	Возврат СоздатьМок(ИсходныйОбъект, Ложь);

КонецФункции

// Создаёт шпиона объекта или типа.
// Вызовы методов без стаба делегируются исходному объекту.
//
// Параметры:
//   ИсходныйОбъект - Произвольный - Инстанс объекта
//                  - Тип - Тип объекта, инстанс которого можно создать конструктором
//
//  Возвращаемое значение:
//   Произвольный - Шпион объекта
//
Функция Следить(Знач ИсходныйОбъект) Экспорт

	Возврат СоздатьМок(ИсходныйОбъект, Истина);

КонецФункции

Функция СоздатьМок(Знач ИсходныйОбъект, Знач ЭтоШпион)

	Лог.Отладка("Тип исходного объекта: %1", ТипЗнч(ИсходныйОбъект));

	РежимСозданияИзТипа = ТипЗнч(ИсходныйОбъект) = Тип("Тип");
	Методы = ЭкспортныеМетоды(ИсходныйОбъект);

	Состояние = Сервис.НовоеСостояние(ЭтоШпион);

	Построитель = Новый ПостроительДекоратора(ИсходныйОбъект)
		.ОбъединятьСлои(Ложь)
		.Поле(Новый Поле("Мок_Сервис"))
		.Поле(Новый Поле("Мок_Состояние"))
		.Метод(Новый Метод("Когда")
			.Публичный()
			.ТелоМетода("Возврат Мок_Сервис.АгентВРежиме(Мок_Состояние, ""Стаб"");"))
		.Метод(Новый Метод("ПроверитьЧтоВызывалсяМетод")
			.Публичный()
			.ТелоМетода("Возврат Мок_Сервис.АгентВРежиме(Мок_Состояние, ""Проверка"");"));

	Если РежимСозданияИзТипа И НЕ ЭтоШпион Тогда
		Построитель.ДопуститьОтсутствиеИнстанса();
	КонецЕсли;

	Для Каждого Метод Из Методы Цикл
		Построитель.Перехватчик(
			Новый Перехватчик(Метод.Имя)
				.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
				.Тело(ТелоПерехватчика(Метод))
		);
	КонецЦикла;

	Попытка
		МокОбъект = Построитель.Построить();
	Исключение
		Если РежимСозданияИзТипа И ЭтоШпион Тогда
			ВызватьИсключение "Невозможно создать объект и данного типа объекта";
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Агент = ПостроитьАгента(Методы);

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(МокОбъект, "Мок_Сервис", Сервис);
	Рефлектор.УстановитьСвойство(МокОбъект, "Мок_Состояние", Состояние);
	Рефлектор.УстановитьСвойство(Агент, "Мок_Сервис", Сервис);
	Рефлектор.УстановитьСвойство(Агент, "Мок_Состояние", Состояние);

	Сервис.УстановитьМок(Состояние, МокОбъект);
	Сервис.УстановитьАгента(Состояние, Агент);

	Возврат МокОбъект;

КонецФункции

// Возвращает описания экспортных методов исходного объекта.
// Имена методов совпадают с именами, которые получат методы декоратора.
Функция ЭкспортныеМетоды(Знач ИсходныйОбъект)

	Методы = Новый Массив;

	ИменаМетодовМока = Новый Массив;
	ИменаМетодовМока.Добавить("когда");
	ИменаМетодовМока.Добавить("проверитьчтовызывалсяметод");

	Рефлектор = Новый Рефлектор;
	ТаблицаМетодов = Рефлектор.ПолучитьТаблицуМетодов(ИсходныйОбъект);

	Для Каждого ОписаниеМетода Из ТаблицаМетодов Цикл

		Если НЕ ОписаниеМетода.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		ИменаПараметров = Новый Массив;
		Параметры = Новый Массив;

		Для Каждого ПараметрМетода Из ОписаниеМетода.Параметры Цикл

			ИмяПараметра = ОбработкаДекоратора.ИмяПараметраДекоратора(ПараметрМетода.Имя);

			ИменаПараметров.Добавить(ИмяПараметра);

			Параметры.Добавить(Новый Структура(
				"Имя, ПоЗначению, ЕстьЗначениеПоУмолчанию, ЗначениеПоУмолчанию",
				ИмяПараметра,
				ПараметрМетода.ПоЗначению,
				ПараметрМетода.ЕстьЗначениеПоУмолчанию,
				ПараметрМетода.ЗначениеПоУмолчанию
			));

		КонецЦикла;

		ИмяМетода = ОбработкаДекоратора.ИмяМетодаДекоратора(ОписаниеМетода.Имя);

		Если ИменаМетодовМока.Найти(НРег(ИмяМетода)) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Метод ""%1"" исходного объекта совпадает с методом API мока и не может быть замокирован",
				ОписаниеМетода.Имя
			);
		КонецЕсли;

		Методы.Добавить(Новый Структура(
			"Имя, ЭтоФункция, Параметры, ИменаПараметров",
			ИмяМетода,
			ОписаниеМетода.ЭтоФункция,
			Параметры,
			ИменаПараметров
		));

	КонецЦикла;

	Возврат Методы;

КонецФункции

Функция ТелоПерехватчика(Знач Метод)

	Тело = Новый Массив;
	ДобавитьСборПараметров(Тело, Метод);

	Тело.Добавить(СтрШаблон(
		"Мок_ОтветСервиса = Мок_Сервис.ОбработатьВызовМетода(Мок_Состояние, ""%1"", Мок_ПараметрыВызова);",
		Метод.Имя
	));

	Тело.Добавить("Если Мок_ОтветСервиса.Прервать Тогда");
	Если Метод.ЭтоФункция Тогда
		Тело.Добавить("	Возврат Мок_ОтветСервиса.Значение;");
	Иначе
		Тело.Добавить("	Возврат;");
	КонецЕсли;
	Тело.Добавить("КонецЕсли;");

	Возврат СтрСоединить(Тело, Символы.ПС);

КонецФункции

Функция ТелоМетодаАгента(Знач Метод)

	Тело = Новый Массив;
	ДобавитьСборПараметров(Тело, Метод);

	Тело.Добавить(СтрШаблон(
		"Возврат Мок_Сервис.ОбработатьОбращениеАгента(Мок_Состояние, Мок_Режим, ""%1"", Мок_ПараметрыВызова);",
		Метод.Имя
	));

	Возврат СтрСоединить(Тело, Символы.ПС);

КонецФункции

Процедура ДобавитьСборПараметров(Тело, Знач Метод)

	Тело.Добавить("Мок_ПараметрыВызова = Новый Массив;");
	Для Каждого ИмяПараметра Из Метод.ИменаПараметров Цикл
		Тело.Добавить(СтрШаблон("Мок_ПараметрыВызова.Добавить(%1);", ИмяПараметра));
	КонецЦикла;

КонецПроцедуры

// Строит агента мока: объект с теми же методами, что у мока, но в виде функций.
// Через агента настраиваются стабы (Когда) и проверяются вызовы (ПроверитьЧтоВызывалсяМетод),
// поэтому цепочка вызовов работает и для мокируемых процедур.
Функция ПостроитьАгента(Знач Методы)

	Построитель = Новый ПостроительДекоратора()
		.ОбъединятьСлои(Ложь)
		.Поле(Новый Поле("Мок_Сервис"))
		.Поле(Новый Поле("Мок_Состояние"))
		.Поле(Новый Поле("Мок_Режим"));

	Для Каждого Метод Из Методы Цикл

		МетодАгента = Новый Метод(Метод.Имя)
			.Публичный()
			.ТелоМетода(ТелоМетодаАгента(Метод));

		Для Каждого ОписаниеПараметра Из Метод.Параметры Цикл

			ПараметрАгента = Новый ПараметрМетода(ОписаниеПараметра.Имя);

			Если ОписаниеПараметра.ПоЗначению Тогда
				ПараметрАгента.ПоЗначению();
			КонецЕсли;

			Если ОписаниеПараметра.ЕстьЗначениеПоУмолчанию Тогда
				ПараметрАгента.ЗначениеПоУмолчанию(ОписаниеПараметра.ЗначениеПоУмолчанию);
			КонецЕсли;

			МетодАгента.Параметр(ПараметрАгента);

		КонецЦикла;

		Построитель.Метод(МетодАгента);

	КонецЦикла;

	Возврат Построитель.Построить();

КонецФункции

Лог = Логирование.ПолучитьЛог("oscript.lib.moskito");
Сервис = Новый МокСервис;
