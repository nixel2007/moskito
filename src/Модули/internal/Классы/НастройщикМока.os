// Настройщик поведения мока, завершающий цепочку Когда().<Метод>(...).
Перем Стаб;

Процедура ПриСозданииОбъекта(Знач НастраиваемыйСтаб)
	Стаб = НастраиваемыйСтаб;
КонецПроцедуры

// Устанавливает значение, возвращаемое застабленным методом.
//
// Параметры:
//   ВозвращаемоеЗначение - Произвольный - Возвращаемое значение
//
Процедура ТогдаВозвращает(Знач ВозвращаемоеЗначение) Экспорт

	Стаб.Значение = ВозвращаемоеЗначение;
	Стаб.Исключение = Неопределено;
	Стаб.ЕстьИсключение = Ложь;

КонецПроцедуры

// Устанавливает исключение, выбрасываемое застабленным методом.
//
// Параметры:
//   ОписаниеИсключения - Строка, ИнформацияОбОшибке - Выбрасываемое исключение
//
Процедура ТогдаВыбрасываетИсключение(Знач ОписаниеИсключения) Экспорт

	Стаб.Значение = NULL;
	Стаб.Исключение = ОписаниеИсключения;
	Стаб.ЕстьИсключение = Истина;

КонецПроцедуры

// Устанавливает обработчик ответа застабленного метода.
//
// Параметры:
//   ОбработчикОтвета - Ответ - Обработчик, вычисляющий возвращаемое значение
//
Процедура ТогдаОтвечает(Знач ОбработчикОтвета) Экспорт

	Стаб.Значение = ОбработчикОтвета;
	Стаб.Исключение = Неопределено;
	Стаб.ЕстьИсключение = Ложь;

КонецПроцедуры
