#Использовать asserts
#Использовать logos

Перем Лог;
Перем Рефлектор;

Процедура ПриСозданииОбъекта()
	Лог = Логирование.ПолучитьЛог("oscript.lib.moskito");
	Рефлектор = Новый Рефлектор;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Создаёт состояние мока: таблицы стабов и вызовов, ссылки на мок и агента.
//
// Параметры:
//   ЭтоШпион - Булево - Вызовы без стаба делегируются исходному объекту
//
//  Возвращаемое значение:
//   Структура - Состояние мока
//
Функция НовоеСостояние(Знач ЭтоШпион) Экспорт

	Возврат Новый Структура(
		"ЭтоШпион, Стабы, Вызовы, Мок, Агент",
		ЭтоШпион, Новый Массив, Новый Массив, Неопределено, Неопределено
	);

КонецФункции

Процедура УстановитьМок(Состояние, Знач Мок) Экспорт
	Состояние.Мок = Мок;
КонецПроцедуры

Процедура УстановитьАгента(Состояние, Знач Агент) Экспорт
	Состояние.Агент = Агент;
КонецПроцедуры

// Возвращает агента мока, переключённого в нужный режим.
//
// Параметры:
//   Состояние - Структура - Состояние мока
//   Режим - Строка - "Стаб" или "Проверка"
//
//  Возвращаемое значение:
//   Произвольный - Агент мока
//
Функция АгентВРежиме(Знач Состояние, Знач Режим) Экспорт

	Рефлектор.УстановитьСвойство(Состояние.Агент, "Мок_Режим", Режим);

	Возврат Состояние.Агент;

КонецФункции

// Обрабатывает вызов метода мока: записывает вызов и ищет стаб.
//
// Параметры:
//   Состояние - Структура - Состояние мока
//   ИмяМетода - Строка - Имя вызванного метода
//   Параметры - Массив - Фактические значения параметров вызова
//
//  Возвращаемое значение:
//   Структура:
//     * Прервать - Булево - Вызов не должен делегироваться исходному объекту
//     * Значение - Произвольный - Возвращаемое из метода значение
//
Функция ОбработатьВызовМетода(Знач Состояние, Знач ИмяМетода, Знач Параметры) Экспорт

	Результат = Новый Структура("Прервать, Значение", НЕ Состояние.ЭтоШпион, NULL);

	ЗаписатьВызов(Состояние, ИмяМетода, Параметры);

	Стаб = НайтиСтаб(Состояние, ИмяМетода, Параметры);
	Если Стаб = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если Стаб.ЕстьИсключение Тогда
		ВызватьИсключение Стаб.Исключение;
	КонецЕсли;

	Если Стаб.Значение = NULL Тогда
		// Стаб без значения равносилен его отсутствию: шпион продолжит делегирование
		Возврат Результат;
	КонецЕсли;

	Значение = Стаб.Значение;
	Если ТипЗнч(Значение) = Тип("Ответ") Тогда
		ИнформацияОВызове = Новый ИнформацияОВызове(Состояние.Мок, ИмяМетода, Параметры);
		Значение = Значение.Исполнить(ИнформацияОВызове);
	КонецЕсли;

	Результат.Прервать = Истина;
	Результат.Значение = Значение;

	Возврат Результат;

КонецФункции

// Обрабатывает обращение к агенту мока из цепочек Когда() и ПроверитьЧтоВызывалсяМетод().
//
// Параметры:
//   Состояние - Структура - Состояние мока
//   Режим - Строка - "Стаб" или "Проверка"
//   ИмяМетода - Строка - Имя метода
//   Параметры - Массив - Значения параметров, допускаются матчеры
//
//  Возвращаемое значение:
//   НастройщикМока - в режиме "Стаб"
//   Неопределено - в режиме "Проверка"
//
Функция ОбработатьОбращениеАгента(Знач Состояние, Знач Режим, Знач ИмяМетода, Знач Параметры) Экспорт

	Если Режим = "Проверка" Тогда
		ПроверитьВызовМетода(Состояние, ИмяМетода, Параметры);
		Возврат Неопределено;
	КонецЕсли;

	Стаб = НайтиСтаб(Состояние, ИмяМетода, Параметры);
	Если Стаб = Неопределено Тогда
		Стаб = Новый Структура(
			"ИмяМетода, Параметры, Значение, Исключение, ЕстьИсключение",
			ИмяМетода, Параметры, NULL, Неопределено, Ложь
		);
		Состояние.Стабы.Добавить(Стаб);
	Иначе
		Стаб.Параметры = Параметры;
	КонецЕсли;

	Возврат Новый НастройщикМока(Стаб);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВызовМетода(Знач Состояние, Знач ИмяМетода, Знач Параметры)

	НайденныйВызов = NULL;
	Для Каждого Вызов Из Состояние.Вызовы Цикл
		Если Вызов.ИмяМетода = ИмяМетода И ПараметрыСовпадают(Параметры, Вызов.Параметры) Тогда
			НайденныйВызов = Вызов;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ТекстСообщения = СтрШаблон("Ожидали, что метод ""%1"" вызывался, а это не так", ИмяМетода);
	Ожидаем.Что(НайденныйВызов, ТекстСообщения).Не_().ЕстьNull();

КонецПроцедуры

Процедура ЗаписатьВызов(Знач Состояние, Знач ИмяМетода, Знач Параметры)

	Состояние.Вызовы.Добавить(
		Новый Структура("ИмяМетода, Параметры", ИмяМетода, Параметры)
	);

КонецПроцедуры

Функция НайтиСтаб(Знач Состояние, Знач ИмяМетода, Знач Параметры)

	Для Каждого Стаб Из Состояние.Стабы Цикл
		Если Стаб.ИмяМетода = ИмяМетода И ПараметрыСовпадают(Стаб.Параметры, Параметры) Тогда
			Возврат Стаб;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Шаблонные параметры могут содержать матчеры, проверяемые - фактические значения.
Функция ПараметрыСовпадают(Знач ШаблонныеПараметры, Знач ПроверяемыеПараметры)

	Если ШаблонныеПараметры.Количество() <> ПроверяемыеПараметры.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 0 По ШаблонныеПараметры.Количество() - 1 Цикл

		ШаблонноеЗначение = ШаблонныеПараметры[Индекс];
		ПроверяемоеЗначение = ПроверяемыеПараметры[Индекс];

		Если ТипЗнч(ШаблонноеЗначение) = Тип("Матчер") Тогда
			Если НЕ ШаблонноеЗначение.Исполнить(ПроверяемоеЗначение) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли НЕ ОбъектыРавны(ШаблонноеЗначение, ПроверяемоеЗначение) Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ОбъектыРавны(Знач Объект1, Знач Объект2)

	ЭтоПримитив1 = ЭтоПримитивныйТип(Объект1);
	ЭтоПримитив2 = ЭтоПримитивныйТип(Объект2);

	Если (ЭтоМокОбъект(Объект1) И НЕ ЭтоПримитив2)
		ИЛИ (ЭтоМокОбъект(Объект2) И НЕ ЭтоПримитив1) Тогда
		// Мок сравнивается с объектом по содержимому, а не по типу
	ИначеЕсли ТипЗнч(Объект1) <> ТипЗнч(Объект2) Тогда
		Возврат Ложь;
	ИначеЕсли ЭтоПримитив1 И ЭтоПримитив2 Тогда
		Возврат Объект1 = Объект2;
	ИначеЕсли ЭтоПримитив1 ИЛИ ЭтоПримитив2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ЭтоКоллекция1 = ЭтоКоллекция(Объект1);
	ЭтоКоллекция2 = ЭтоКоллекция(Объект2);

	Если ЭтоКоллекция1 И ЭтоКоллекция2 Тогда
		Возврат КоллекцииРавны(Объект1, Объект2);
	ИначеЕсли ЭтоКоллекция1 ИЛИ ЭтоКоллекция2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СвойстваРавны(Объект1, Объект2);

КонецФункции

Функция КоллекцииРавны(Знач Коллекция1, Знач Коллекция2)

	Элементы1 = Новый Массив;
	Для Каждого Элемент Из Коллекция1 Цикл
		Элементы1.Добавить(Элемент);
	КонецЦикла;

	Элементы2 = Новый Массив;
	Для Каждого Элемент Из Коллекция2 Цикл
		Элементы2.Добавить(Элемент);
	КонецЦикла;

	Если Элементы1.Количество() <> Элементы2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 0 По Элементы1.Количество() - 1 Цикл
		Если НЕ ОбъектыРавны(Элементы1[Индекс], Элементы2[Индекс]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СвойстваРавны(Знач Объект1, Знач Объект2)

	Свойства1 = Рефлектор.ПолучитьТаблицуСвойств(Объект1);
	Свойства2 = Рефлектор.ПолучитьТаблицуСвойств(Объект2);

	Если Свойства1.Количество() <> Свойства2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Свойство1 Из Свойства1 Цикл

		Если Свойства2.Найти(Свойство1.Имя, "Имя") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Значение1 = Рефлектор.ПолучитьСвойство(Объект1, Свойство1.Имя);
		Значение2 = Рефлектор.ПолучитьСвойство(Объект2, Свойство1.Имя);

		Если НЕ ОбъектыРавны(Значение1, Значение2) Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоПримитивныйТип(Знач Значение)

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Неопределено")
		ИЛИ ТипЗначения = Тип("NULL")
		ИЛИ ТипЗначения = Тип("Тип");

КонецФункции

Функция ЭтоМокОбъект(Знач Объект)

	Если ТипЗнч(Объект) <> Тип("Сценарий") Тогда
		Возврат Ложь;
	КонецЕсли;

	МетодыОбъекта = Рефлектор.ПолучитьТаблицуМетодов(Объект);

	Возврат МетодыОбъекта.Найти("Когда", "Имя") <> Неопределено
		И МетодыОбъекта.Найти("ПроверитьЧтоВызывалсяМетод", "Имя") <> Неопределено;

КонецФункции

Функция ЭтоКоллекция(Знач Объект)

	ЕстьПоддержкаОбхода = Истина;
	Попытка
		Для Каждого Элемент Из Объект Цикл
			Прервать;
		КонецЦикла;
	Исключение
		ЕстьПоддержкаОбхода = Ложь;
	КонецПопытки;

	Возврат ЕстьПоддержкаОбхода;

КонецФункции

#КонецОбласти
